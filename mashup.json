    {
      "game": "minecraft",
      "strategy": "mrpack",
      "pack": {
        "src": "falloutcraft.mrpack",
        "url": "https://github.com/SIGFAI/falloutcraft/releases/download/v0.1.3/falloutcraft.mrpack",
        "sha256": "9da5a7bac19278b0c156a347331b0fe7fbb6b197a87a4e2a28898dd24835b667",
        "size": 260312
