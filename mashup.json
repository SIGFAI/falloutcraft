            },
            {
              "path": "F4SE/Plugins/FalloutCraft/SOURCE.txt",
              "sha256": "904e3dfd2df691b9db6c78db1ff7af2d81e11e044f597ddf39ef672e8c449e9f"
            }
          ],
          "url": "https://github.com/SIGFAI/falloutcraft/releases/download/v0.1.3/falloutcraft-fallout4.zip",
          "sha256": "5336217541d8d7ddbd0a020bd7cbf8dd9a9776ae1c17e62ff9f9ac3f44844520",
          "size": 812092
        }
      ]
