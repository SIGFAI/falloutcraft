{
  "id": "sigf/falloutcraft",
  "version": "0.1.3",
  "name": "FalloutCraft",
  "tagline": "Play Fallout 4 as a Minecraft player: Minecraft physics, inventory, blocks and combat inside the Commonwealth (F4SE plugin + Fabric mod). Built on SkyCraft.",
  "kind": "passthrough",
  "games": [
    {
      "game": "fallout4",
      "role": "host",
      "engine": "Fallout 4 next-gen runtime + F4SE plugin (C++, CommonLibF4)",
      "apps": {
        "steam": "377160"
      },
      "runtime": "1.11.240 (next-gen); the old-gen 1.10.163 runtime is not supported"
    },
    {
      "game": "minecraft",
      "role": "guest",
      "label": "Minecraft",
      "mc": "26.3",
      "loader": "fabric@0.19.5",
      "java": "25"
    }
  ],
  "requires": [
    {
      "id": "f4se",
      "version": "0.7.9",
      "page": "https://f4se.silverlock.org/",
      "license": "no redistribution (f4se_readme.txt)",
      "note": "start Fallout 4 with f4se_loader.exe"
    },
    {
      "id": "address-library-f4se",
      "page": "https://www.nexusmods.com/fallout4/mods/47327",
      "license": "Nexus Mods download only",
      "note": "the \"All in One\" file for your game version"
    },
    {
      "id": "fabric-loader",
      "version": "0.19.5"
    }
  ],
  "install": [
    {
      "game": "fallout4",
      "strategy": "game-dir-snapshot",
